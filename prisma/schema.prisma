generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  SCHEDULED
  LIVE
  PAUSED
  POSTPONED
  CANCELLED
  FINISHED
}

enum MatchOutcome {
  HOME
  DRAW
  AWAY
}

enum LeagueType {
  GLOBAL
  PRIVATE
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum StageType {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum AdminMessageAudienceType {
  ALL
  USER
  LEAGUE
}

model User {
  isSystem                Boolean                   @default(false) @map("is_system")
  notificationSettings    Json                      @default("{}") @map("notification_settings")
  seasonStandings         SeasonStanding[]
  gameweekStandings       GameweekStanding[]
  bankers                 GameweekBanker[]
  seasonPicks             SeasonPick[]
  rivals                  SeasonRival[]             @relation("RivalOwner")
  rivalOf                 SeasonRival[]             @relation("RivalTarget")
  achievements            UserAchievement[]
  bonusAnswers            BonusAnswer[]
  platformNotifications   PlatformNotification[]
  h2hHome                 H2HFixture[]              @relation("H2HHome")
  h2hAway                 H2HFixture[]              @relation("H2HAway")
  seasonLeagueEntries     LeagueSeasonParticipant[]
  aiGenerations           AIGeneration[]
  id                      String                    @id @default(uuid()) @db.Uuid
  email                   String                    @unique
  phone                   String?
  passwordHash            String?                   @map("password_hash")
  displayName             String                    @map("display_name")
  avatarUrl               String?                   @map("avatar_url")
  registrationTimestamp   DateTime                  @default(now()) @map("registration_timestamp") @db.Timestamptz(6)
  globalPoints            Int                       @default(0) @map("global_points")
  exactScoresCount        Int                       @default(0) @map("exact_scores_count")
  correctOutcomesCount    Int                       @default(0) @map("correct_outcomes_count")
  matchesPlayedCount      Int                       @default(0) @map("matches_played_count")
  isAdmin                 Boolean                   @default(false) @map("is_admin")
  isBanned                Boolean                   @default(false) @map("is_banned")
  banReason               String?                   @map("ban_reason")
  bannedAt                DateTime?                 @map("banned_at") @db.Timestamptz(6)
  onboardingCompletedAt   DateTime?                 @map("onboarding_completed_at") @db.Timestamptz(6)
  preferredLocale         String                    @default("en") @map("preferred_locale")
  predictions             Prediction[]
  outrights               Outright?
  leagueMemberships       LeagueMember[]
  oauthAccounts           OAuthAccount[]
  sessions                UserSession[]
  notificationPreferences NotificationPreference[]
  notificationDeliveries  NotificationDelivery[]
  rankSnapshots           LeagueRankSnapshot[]
  shareCards              ShareCard[]
  announcementViews       AnnouncementView[]
  passwordResetTokens     PasswordResetToken[]
  adminMessageReceipts    AdminMessageReceipt[]

  @@index([globalPoints(sort: Desc), matchesPlayedCount(sort: Asc), registrationTimestamp(sort: Asc)], map: "leaderboard_tiebreaker_idx")
  @@index([isBanned])
  @@map("users")
}

model AdminAccount {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  passwordHash       String    @map("password_hash")
  displayName        String    @map("display_name")
  isSuperAdmin       Boolean   @default(false) @map("is_super_admin")
  twoFactorSecret    String?   @map("two_factor_secret")
  twoFactorEnabledAt DateTime? @map("two_factor_enabled_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_accounts")
}

model OAuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model Tournament {
  generalizedSeason   Season?
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  slug                String               @unique
  externalId          String?              @unique @map("external_id")
  startsAt            DateTime             @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime?            @map("ends_at") @db.Timestamptz(6)
  syncFromAt          DateTime?            @map("sync_from_at") @db.Timestamptz(6)
  hostCountries       String[]             @default([]) @map("host_countries")
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  teams               Team[]
  players             Player[]
  matches             Match[]
  outrights           Outright[]
  outrightSettlements OutrightSettlement[]

  @@index([isActive, startsAt])
  @@map("tournaments")
}

model Team {
  seasonId            String?     @map("season_id") @db.Uuid
  badgeUrl            String?     @map("badge_url")
  season              Season?     @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  id                  String      @id @default(uuid()) @db.Uuid
  tournamentId        String?     @map("tournament_id") @db.Uuid
  externalId          String?     @map("external_id")
  name                String
  shortName           String?     @map("short_name")
  flagEmoji           String?     @map("flag_emoji")
  groupName           String?     @map("group_name")
  tournament          Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  players             Player[]
  homeMatches         Match[]     @relation("HomeTeam")
  awayMatches         Match[]     @relation("AwayTeam")
  championPicks       Outright[]  @relation("ChampionTeam")
  secondRunnerUpPicks Outright[]  @relation("SecondRunnerUpTeam")
  thirdPlacePicks     Outright[]  @relation("ThirdPlaceTeam")
  fairPlayPicks       Outright[]  @relation("FairPlayTeam")

  @@unique([tournamentId, name])
  @@unique([tournamentId, externalId])
  @@unique([seasonId, externalId])
  @@unique([seasonId, name])
  @@index([tournamentId, groupName])
  @@map("teams")
}

model Player {
  seasonId               String?              @map("season_id") @db.Uuid
  season                 Season?              @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  id                     String               @id @default(uuid()) @db.Uuid
  tournamentId           String?              @map("tournament_id") @db.Uuid
  teamId                 String?              @map("team_id") @db.Uuid
  externalId             String?              @map("external_id")
  name                   String
  sequenceNumber         Int?                 @map("sequence_number")
  position               String?
  isGoalkeeper           Boolean              @default(false) @map("is_goalkeeper")
  source                 String               @default("API")
  tournament             Tournament?          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team                   Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  bestPlayerPicks        Outright[]           @relation("BestPlayer")
  bestGoalkeeperPicks    Outright[]           @relation("BestGoalkeeper")
  goldenBootPicks        Outright[]           @relation("GoldenBoot")
  youngPlayerPicks       Outright[]           @relation("YoungPlayer")
  goldenBallSettlements  OutrightSettlement[] @relation("GoldenBallWinner")
  goldenGloveSettlements OutrightSettlement[] @relation("GoldenGloveWinner")

  @@unique([tournamentId, externalId])
  @@unique([seasonId, externalId])
  @@index([tournamentId, isGoalkeeper])
  @@index([tournamentId, sequenceNumber])
  @@index([tournamentId, source])
  @@index([teamId])
  @@map("players")
}

model Match {
  isResultOverride       Boolean                @default(false) @map("is_result_override")
  competitionId          String?                @map("competition_id") @db.Uuid
  seasonId               String?                @map("season_id") @db.Uuid
  gameweekId             String?                @map("gameweek_id") @db.Uuid
  scoringGameweekId      String?                @map("scoring_gameweek_id") @db.Uuid
  predictionLockAt       DateTime?              @map("prediction_lock_at") @db.Timestamptz(6)
  competition            Competition?           @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  season                 Season?                @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  gameweek               Gameweek?              @relation("FixtureGameweek", fields: [gameweekId], references: [id], onDelete: Restrict)
  scoringGameweek        Gameweek?              @relation("ScoringGameweek", fields: [scoringGameweekId], references: [id], onDelete: Restrict)
  bankers                GameweekBanker[]
  consensus              ConsensusSnapshot?
  aiGenerations          AIGeneration[]
  id                     Int                    @id @default(autoincrement())
  tournamentId           String?                @map("tournament_id") @db.Uuid
  externalId             String?                @unique @map("external_id")
  matchday               Int?
  stage                  StageType              @default(GROUP)
  groupName              String?                @map("group_name")
  homeTeam               String                 @map("home_team")
  awayTeam               String                 @map("away_team")
  homeTeamId             String?                @map("home_team_id") @db.Uuid
  awayTeamId             String?                @map("away_team_id") @db.Uuid
  venue                  String?
  kickoffTime            DateTime               @map("kickoff_time") @db.Timestamptz(6)
  status                 MatchStatus            @default(SCHEDULED)
  isEnabled              Boolean                @default(true) @map("is_enabled")
  homeScore              Int?                   @map("home_score")
  awayScore              Int?                   @map("away_score")
  homeScore90            Int?                   @map("home_score_90")
  awayScore90            Int?                   @map("away_score_90")
  actualPenaltyShootout  Boolean?               @map("actual_penalty_shootout")
  highlightUrl           String?                @map("highlight_url")
  lastSyncedAt           DateTime?              @map("last_synced_at") @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  tournament             Tournament?            @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  homeTeamRef            Team?                  @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamRef            Team?                  @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  predictions            Prediction[]
  notificationDeliveries NotificationDelivery[]
  shareCardItems         ShareCardItem[]

  @@index([matchday, kickoffTime])
  @@index([status, kickoffTime])
  @@index([isEnabled, kickoffTime])
  @@index([tournamentId, stage, kickoffTime])
  @@map("matches")
}

model Prediction {
  basePoints               Int?          @map("base_points")
  pointsMultiplier         Int           @default(1) @map("points_multiplier")
  upsetPoints              Int           @default(0) @map("upset_points")
  id                       String        @id @default(uuid()) @db.Uuid
  userId                   String        @map("user_id") @db.Uuid
  matchId                  Int           @map("match_id")
  predictedOutcome         MatchOutcome? @map("predicted_outcome")
  predictedHomeScore       Int?          @map("predicted_home_score")
  predictedAwayScore       Int?          @map("predicted_away_score")
  predictedPenaltyShootout Boolean?      @map("predicted_penalty_shootout")
  pointsAwarded            Int?          @map("points_awarded")
  isExactScore             Boolean       @default(false) @map("is_exact_score")
  isCorrectOutcome         Boolean       @default(false) @map("is_correct_outcome")
  isLocked                 Boolean       @default(false) @map("is_locked")
  submittedAt              DateTime      @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  scoredAt                 DateTime?     @map("scored_at") @db.Timestamptz(6)
  user                     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  match                    Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([userId, submittedAt])
  @@map("predictions")
}

model Outright {
  userId               String      @id @map("user_id") @db.Uuid
  tournamentId         String?     @map("tournament_id") @db.Uuid
  championTeamId       String      @map("champion_team_id") @db.Uuid
  secondRunnerUpTeamId String      @map("second_runner_up_team_id") @db.Uuid
  thirdPlaceTeamId     String?     @map("third_place_team_id") @db.Uuid
  fairPlayTeamId       String      @map("fair_play_team_id") @db.Uuid
  bestPlayerId         String      @map("best_player_id") @db.Uuid
  bestGkId             String      @map("best_gk_id") @db.Uuid
  goldenBootPlayerId   String      @map("golden_boot_player_id") @db.Uuid
  youngPlayerId        String      @map("young_player_id") @db.Uuid
  pointsAwarded        Int?        @map("points_awarded")
  submittedAt          DateTime    @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament           Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  championTeam         Team        @relation("ChampionTeam", fields: [championTeamId], references: [id], onDelete: Restrict)
  secondRunnerUpTeam   Team        @relation("SecondRunnerUpTeam", fields: [secondRunnerUpTeamId], references: [id], onDelete: Restrict)
  thirdPlaceTeam       Team?       @relation("ThirdPlaceTeam", fields: [thirdPlaceTeamId], references: [id], onDelete: Restrict)
  fairPlayTeam         Team        @relation("FairPlayTeam", fields: [fairPlayTeamId], references: [id], onDelete: Restrict)
  bestPlayer           Player      @relation("BestPlayer", fields: [bestPlayerId], references: [id], onDelete: Restrict)
  bestGoalkeeper       Player      @relation("BestGoalkeeper", fields: [bestGkId], references: [id], onDelete: Restrict)
  goldenBoot           Player      @relation("GoldenBoot", fields: [goldenBootPlayerId], references: [id], onDelete: Restrict)
  youngPlayer          Player      @relation("YoungPlayer", fields: [youngPlayerId], references: [id], onDelete: Restrict)

  @@index([tournamentId])
  @@map("outrights")
}

model League {
  seasons             LeagueSeason[]
  id                  String                     @id @default(uuid()) @db.Uuid
  name                String
  joinCode            String                     @unique @map("join_code") @db.VarChar(8)
  type                LeagueType                 @default(PRIVATE)
  ownerUserId         String?                    @map("owner_user_id") @db.Uuid
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships         LeagueMember[]
  rankSnapshots       LeagueRankSnapshot[]
  adminMessageTargets AdminMessageLeagueTarget[]

  @@index([type])
  @@map("leagues")
}

model LeagueMember {
  leagueId String   @map("league_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([leagueId, userId])
  @@index([userId])
  @@map("league_members")
}

model LeagueRankSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  leagueId    String   @map("league_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  rank        Int
  totalPoints Int      @map("total_points")
  capturedAt  DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)
  league      League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId, capturedAt])
  @@index([leagueId, capturedAt])
  @@index([userId, capturedAt])
  @@map("league_rank_snapshots")
}

model NotificationPreference {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  endpoint  String
  isEnabled Boolean             @default(true) @map("is_enabled")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, endpoint])
  @@index([userId, isEnabled])
  @@map("notification_preferences")
}

model NotificationDelivery {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  matchId      Int?                @map("match_id")
  channel      NotificationChannel
  status       NotificationStatus  @default(PENDING)
  payload      Json
  error        String?
  scheduledFor DateTime            @map("scheduled_for") @db.Timestamptz(6)
  sentAt       DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  match        Match?              @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId, createdAt])
  @@map("notification_deliveries")
}

model AdminMessage {
  id                  String                     @id @default(uuid()) @db.Uuid
  title               String
  body                String                     @db.Text
  audienceType        AdminMessageAudienceType   @map("audience_type")
  sentByAdminId       String?                    @map("sent_by_admin_id") @db.Uuid
  sentByAdminUsername String?                    @map("sent_by_admin_username")
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  receipts            AdminMessageReceipt[]
  leagueTargets       AdminMessageLeagueTarget[]

  @@index([createdAt])
  @@index([audienceType, createdAt])
  @@map("admin_messages")
}

model AdminMessageReceipt {
  id          String       @id @default(uuid()) @db.Uuid
  messageId   String       @map("message_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  deliveredAt DateTime     @default(now()) @map("delivered_at") @db.Timestamptz(6)
  readAt      DateTime?    @map("read_at") @db.Timestamptz(6)
  message     AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt, deliveredAt])
  @@index([messageId])
  @@map("admin_message_receipts")
}

model AdminMessageLeagueTarget {
  messageId String       @map("message_id") @db.Uuid
  leagueId  String       @map("league_id") @db.Uuid
  message   AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  league    League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@id([messageId, leagueId])
  @@index([leagueId])
  @@map("admin_message_league_targets")
}

model ShareCard {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  shareDate DateTime        @map("share_date") @db.Date
  title     String
  body      String
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ShareCardItem[]

  @@unique([userId, shareDate])
  @@map("share_cards")
}

model ShareCardItem {
  shareCardId        String    @map("share_card_id") @db.Uuid
  matchId            Int       @map("match_id")
  predictedHomeScore Int       @map("predicted_home_score")
  predictedAwayScore Int       @map("predicted_away_score")
  shareCard          ShareCard @relation(fields: [shareCardId], references: [id], onDelete: Cascade)
  match              Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([shareCardId, matchId])
  @@index([matchId])
  @@map("share_card_items")
}

model Announcement {
  id                    String             @id @default(uuid()) @db.Uuid
  title                 String
  description           String             @db.Text
  imageUrl              String             @map("image_url") @db.Text
  linkUrl               String             @map("link_url") @db.Text
  isActive              Boolean            @default(true) @map("is_active")
  displayFrequencyHours Int                @default(24) @map("display_frequency_hours")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  views                 AnnouncementView[]

  @@index([isActive, createdAt])
  @@map("announcements")
}

model AnnouncementView {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  seenAt         DateTime     @default(now()) @map("seen_at") @db.Timestamptz(6)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, seenAt])
  @@map("announcement_views")
}

model AppSetting {
  id                      Int      @id @default(1)
  announcementText        String?  @map("announcement_text")
  bannerImageUrl          String?  @map("banner_image_url")
  loginBackgroundImageUrl String?  @map("login_background_image_url")
  maintenanceMode         Boolean  @default(false) @map("maintenance_mode")
  playerCatalogSource     String   @default("API") @map("player_catalog_source")
  gameRulesHtml           String?  @map("game_rules_html")
  termsConditionsHtml     String?  @map("terms_conditions_html")
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model AdminJobStatus {
  key           String    @id
  label         String
  lastRunAt     DateTime? @map("last_run_at") @db.Timestamptz(6)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  lastPayload   Json?     @map("last_payload")
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_job_statuses")
}

model OutrightSettlement {
  id                  String     @id @default(uuid()) @db.Uuid
  tournamentId        String     @unique @map("tournament_id") @db.Uuid
  goldenBallPlayerId  String     @map("golden_ball_player_id") @db.Uuid
  goldenGlovePlayerId String     @map("golden_glove_player_id") @db.Uuid
  settledAt           DateTime   @default(now()) @map("settled_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  goldenBallPlayer    Player     @relation("GoldenBallWinner", fields: [goldenBallPlayerId], references: [id], onDelete: Restrict)
  goldenGlovePlayer   Player     @relation("GoldenGloveWinner", fields: [goldenGlovePlayerId], references: [id], onDelete: Restrict)

  @@index([settledAt])
  @@map("outright_settlements")
}

enum CompetitionType {
  LEAGUE
  KNOCKOUT
  HYBRID
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum GameweekStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum SeasonPickTarget {
  TEAM
  PLAYER
}

enum LeagueMode {
  CLASSIC
  HEAD_TO_HEAD
}

model Competition {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  shortName       String          @map("short_name")
  slug            String          @unique
  logoUrl         String?         @map("logo_url")
  region          String?
  type            CompetitionType
  provider        String          @default("football-data")
  providerCode    String?         @map("provider_code")
  externalId      String?         @map("external_id")
  isActive        Boolean         @default(true) @map("is_active")
  displayPriority Int             @default(0) @map("display_priority")
  seasons         Season[]
  matches         Match[]
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerCode])
  @@map("competitions")
}

model Season {
  usesGameweeks      Boolean                @default(false) @map("uses_gameweeks")
  id                 String                 @id @default(uuid()) @db.Uuid
  competitionId      String                 @map("competition_id") @db.Uuid
  legacyTournamentId String?                @unique @map("legacy_tournament_id") @db.Uuid
  displayName        String                 @map("display_name")
  startsAt           DateTime               @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime?              @map("ends_at") @db.Timestamptz(6)
  providerSeason     Int?                   @map("provider_season")
  isCurrent          Boolean                @default(false) @map("is_current")
  status             SeasonStatus           @default(UPCOMING)
  timezone           String                 @default("UTC")
  scoringRules       Json                   @default("{\"outcome\":1,\"exact\":3,\"penalty\":0,\"legacyKnockout\":false}") @map("scoring_rules")
  picksLockAt        DateTime?              @map("picks_lock_at") @db.Timestamptz(6)
  picksLockGameweek  Int?                   @default(3) @map("picks_lock_gameweek")
  underdogEnabled    Boolean                @default(false) @map("underdog_enabled")
  underdogThreshold  Float                  @default(15) @map("underdog_threshold")
  underdogPoints     Int                    @default(1) @map("underdog_points")
  underdogMinSample  Int                    @default(20) @map("underdog_min_sample")
  aiConfig           Json                   @default("{\"enabled\":false}") @map("ai_config")
  competition        Competition            @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  legacyTournament   Tournament?            @relation(fields: [legacyTournamentId], references: [id], onDelete: Restrict)
  gameweeks          Gameweek[]
  matches            Match[]
  teams              Team[]
  players            Player[]
  pickRules          SeasonPickRule[]
  standings          SeasonStanding[]
  rivals             SeasonRival[]
  achievements       UserAchievement[]
  leagues            LeagueSeason[]
  notifications      PlatformNotification[]
  aiGenerations      AIGeneration[]
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([competitionId, displayName])
  @@index([isCurrent, status])
  @@map("seasons")
}

model Gameweek {
  id             String             @id @default(uuid()) @db.Uuid
  seasonId       String             @map("season_id") @db.Uuid
  number         Int
  name           String?
  startsAt       DateTime?          @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime?          @map("ends_at") @db.Timestamptz(6)
  status         GameweekStatus     @default(UPCOMING)
  finalized      Boolean            @default(false)
  finalizedAt    DateTime?          @map("finalized_at") @db.Timestamptz(6)
  season         Season             @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  matches        Match[]            @relation("FixtureGameweek")
  scoringMatches Match[]            @relation("ScoringGameweek")
  bankers        GameweekBanker[]
  standings      GameweekStanding[]
  achievements   UserAchievement[]
  bonusQuestions BonusQuestion[]
  h2hFixtures    H2HFixture[]

  @@unique([seasonId, number])
  @@map("gameweeks")
}

model GameweekBanker {
  userId     String    @map("user_id") @db.Uuid
  gameweekId String    @map("gameweek_id") @db.Uuid
  matchId    Int       @map("match_id")
  chosenAt   DateTime  @default(now()) @map("chosen_at") @db.Timestamptz(6)
  lockedAt   DateTime? @map("locked_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameweek   Gameweek  @relation(fields: [gameweekId], references: [id], onDelete: Restrict)
  match      Match     @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@id([userId, gameweekId])
  @@unique([userId, matchId])
  @@map("gameweek_bankers")
}

model SeasonStanding {
  seasonId        String @map("season_id") @db.Uuid
  userId          String @map("user_id") @db.Uuid
  totalPoints     Int    @default(0) @map("total_points")
  exactScores     Int    @default(0) @map("exact_scores")
  correctOutcomes Int    @default(0) @map("correct_outcomes")
  gameweekWins    Int    @default(0) @map("gameweek_wins")
  predictionCount Int    @default(0) @map("prediction_count")
  rank            Int    @default(0)
  stats           Json   @default("{}")
  season          Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([seasonId, userId])
  @@map("season_standings")
}

model GameweekStanding {
  gameweekId        String    @map("gameweek_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  points            Int
  exactScores       Int       @map("exact_scores")
  correctOutcomes   Int       @map("correct_outcomes")
  predictionCount   Int       @map("prediction_count")
  rank              Int
  cumulativePoints  Int       @map("cumulative_points")
  cumulativeRank    Int       @map("cumulative_rank")
  cumulativeExact   Int       @map("cumulative_exact")
  cumulativeCorrect Int       @map("cumulative_correct")
  cumulativeWins    Int       @map("cumulative_wins")
  lastSubmittedAt   DateTime? @map("last_submitted_at") @db.Timestamptz(6)
  gameweek          Gameweek  @relation(fields: [gameweekId], references: [id], onDelete: Restrict)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gameweekId, userId])
  @@map("gameweek_standings")
}

model SeasonPickRule {
  id                String           @id @default(uuid()) @db.Uuid
  seasonId          String           @map("season_id") @db.Uuid
  key               String
  target            SeasonPickTarget
  selectionCount    Int              @default(1) @map("selection_count")
  points            Int
  enabled           Boolean          @default(true)
  lockAt            DateTime?        @map("lock_at") @db.Timestamptz(6)
  settledSelections String[]         @default([]) @map("settled_selections")
  settled           Boolean          @default(false)
  season            Season           @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  picks             SeasonPick[]

  @@unique([seasonId, key])
  @@map("season_pick_rules")
}

model SeasonPick {
  id            String         @id @default(uuid()) @db.Uuid
  ruleId        String         @map("rule_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  selections    String[]
  pointsAwarded Int?           @map("points_awarded")
  submittedAt   DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(6)
  rule          SeasonPickRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ruleId, userId])
  @@map("season_picks")
}

model SeasonRival {
  seasonId String @map("season_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  rivalId  String @map("rival_id") @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  user     User   @relation("RivalOwner", fields: [userId], references: [id], onDelete: Cascade)
  rival    User   @relation("RivalTarget", fields: [rivalId], references: [id], onDelete: Cascade)

  @@id([seasonId, userId])
  @@map("season_rivals")
}

model AchievementDefinition {
  id       String            @id
  criteria Json
  enabled  Boolean           @default(true)
  awards   UserAchievement[]

  @@map("achievement_definitions")
}

model UserAchievement {
  id           String                @id @default(uuid()) @db.Uuid
  definitionId String                @map("definition_id")
  userId       String                @map("user_id") @db.Uuid
  seasonId     String                @map("season_id") @db.Uuid
  gameweekId   String?               @map("gameweek_id") @db.Uuid
  contextKey   String                @map("context_key")
  earnedAt     DateTime              @default(now()) @map("earned_at") @db.Timestamptz(6)
  revokedAt    DateTime?             @map("revoked_at") @db.Timestamptz(6)
  metadata     Json                  @default("{}")
  definition   AchievementDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  season       Season                @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  gameweek     Gameweek?             @relation(fields: [gameweekId], references: [id], onDelete: Restrict)

  @@unique([userId, seasonId, definitionId, contextKey])
  @@map("user_achievements")
}

model LeagueSeason {
  id                   String                    @id @default(uuid()) @db.Uuid
  leagueId             String                    @map("league_id") @db.Uuid
  seasonId             String                    @map("season_id") @db.Uuid
  mode                 LeagueMode                @default(CLASSIC)
  participantsLockedAt DateTime?                 @map("participants_locked_at") @db.Timestamptz(6)
  league               League                    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season               Season                    @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  participants         LeagueSeasonParticipant[]
  fixtures             H2HFixture[]

  @@unique([leagueId, seasonId])
  @@map("league_seasons")
}

model LeagueSeasonParticipant {
  leagueSeasonId String       @map("league_season_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  h2hEligible    Boolean      @default(false) @map("h2h_eligible")
  leagueSeason   LeagueSeason @relation(fields: [leagueSeasonId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([leagueSeasonId, userId])
  @@map("league_season_participants")
}

model H2HFixture {
  id              String       @id @default(uuid()) @db.Uuid
  leagueSeasonId  String       @map("league_season_id") @db.Uuid
  gameweekId      String       @map("gameweek_id") @db.Uuid
  slot            Int
  homeUserId      String       @map("home_user_id") @db.Uuid
  awayUserId      String?      @map("away_user_id") @db.Uuid
  homePoints      Int?         @map("home_points")
  awayPoints      Int?         @map("away_points")
  homeTablePoints Int?         @map("home_table_points")
  awayTablePoints Int?         @map("away_table_points")
  leaderBeforeId  String?      @map("leader_before_id") @db.Uuid
  settled         Boolean      @default(false)
  leagueSeason    LeagueSeason @relation(fields: [leagueSeasonId], references: [id], onDelete: Cascade)
  gameweek        Gameweek     @relation(fields: [gameweekId], references: [id], onDelete: Restrict)
  homeUser        User         @relation("H2HHome", fields: [homeUserId], references: [id], onDelete: Cascade)
  awayUser        User?        @relation("H2HAway", fields: [awayUserId], references: [id], onDelete: Cascade)

  @@unique([leagueSeasonId, gameweekId, slot])
  @@map("h2h_fixtures")
}

model BonusQuestion {
  id            String        @id @default(uuid()) @db.Uuid
  gameweekId    String        @map("gameweek_id") @db.Uuid
  text          String
  textMy        String?       @map("text_my")
  type          String        @default("SINGLE_CHOICE")
  options       Json
  points        Int
  lockAt        DateTime      @map("lock_at") @db.Timestamptz(6)
  isActive      Boolean       @default(true) @map("is_active")
  settledAnswer String?       @map("settled_answer")
  gameweek      Gameweek      @relation(fields: [gameweekId], references: [id], onDelete: Restrict)
  answers       BonusAnswer[]

  @@map("bonus_questions")
}

model BonusAnswer {
  questionId    String        @map("question_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  answer        String
  pointsAwarded Int?          @map("points_awarded")
  submittedAt   DateTime      @default(now()) @map("submitted_at") @db.Timestamptz(6)
  question      BonusQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([questionId, userId])
  @@map("bonus_answers")
}

model ConsensusSnapshot {
  matchId         Int      @id @map("match_id")
  homeCount       Int      @map("home_count")
  drawCount       Int      @map("draw_count")
  awayCount       Int      @map("away_count")
  predictionCount Int      @map("prediction_count")
  averageHome     Float    @map("average_home")
  averageAway     Float    @map("average_away")
  frozenAt        DateTime @map("frozen_at") @db.Timestamptz(6)
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@map("consensus_snapshots")
}

model AIGeneration {
  id          String    @id @default(uuid()) @db.Uuid
  seasonId    String    @map("season_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  matchId     Int       @map("match_id")
  provider    String
  model       String
  status      String
  generatedAt DateTime? @map("generated_at") @db.Timestamptz(6)
  error       String?
  season      Season    @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@unique([userId, matchId])
  @@map("ai_generations")
}

model PlatformNotification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  seasonId  String    @map("season_id") @db.Uuid
  eventKey  String    @map("event_key")
  type      String
  params    Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  season    Season    @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  @@unique([userId, eventKey])
  @@index([userId, createdAt])
  @@map("platform_notifications")
}
